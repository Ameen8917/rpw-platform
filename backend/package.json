{
  "name": "@rpw/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:check": "tsx src/scripts/db-check.ts",
    "db:check:test": "tsx src/scripts/db-check.ts --test",
    "db:migrate": "tsx src/scripts/migrate.ts up",
    "db:migrate:status": "tsx src/scripts/migrate.ts status"
  },
  "dependencies": {
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "5.1.0",
    "helmet": "8.0.0",
    "pg": "8.13.1",
    "pg-hstore": "2.3.4",
    "sequelize": "6.37.5",
    "umzug": "3.8.2",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.0",
    "@types/node": "22.10.2",
    "@types/supertest": "6.0.2",
    "eslint": "9.17.0",
    "globals": "15.14.0",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.2",
    "vitest": "2.1.8"
  }
}
