# Copy to backend/.env and fill in. Never commit the real .env.

NODE_ENV=development
PORT=4000
# Browser origin allowed to call the API (the Vite dev server)
CORS_ORIGIN=http://localhost:5173

# Supabase → Connect (top bar) → Connection string → "Session pooler" (port 5432).
# Replace [YOUR-PASSWORD] with the database password.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Our tables live in this schema, not "public", so Supabase's Data API does not expose them
DATABASE_SCHEMA=rpw
# Supabase requires TLS; only set false for a local database without TLS
DATABASE_SSL=true
# Optional: path to Supabase's CA certificate (Database settings → SSL) to verify the server certificate.
# Without it the connection is still encrypted, but the certificate is not verified.
DATABASE_SSL_CA_PATH=

# Integration tests only: a SEPARATE Supabase project. Tests refuse to run if it equals DATABASE_URL.
TEST_DATABASE_URL=

# Sign-in sessions. At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs everyone out.
SESSION_SECRET=
# How long a sign-in lasts
SESSION_TTL_HOURS=12

# npm run db:seed: initial password for seeded users who can sign in (min 8 characters).
# Only applied to users without a password, so re-seeding never resets changed passwords.
SEED_USER_PASSWORD=

# "Sign in as" any user without a password, for development. Refused when NODE_ENV=production.
DEV_LOGIN_ENABLED=false

# --- Later milestones (not read yet) ---
# M4 file storage:   SUPABASE_URL=  SUPABASE_SERVICE_ROLE_KEY=  SUPABASE_STORAGE_BUCKET=
# M7 invoice AI:     ANTHROPIC_API_KEY=   (optional; manual entry works without it)

# --- Supabase Storage (signatures, invoice files) ---
# Optional in development: without these the API runs, but saving a signature answers 503.
# Required in production. Only the backend uses them; never put them in frontend code.
# Project URL: Project Settings -> Data API (or API), e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Secret key: Project Settings -> API Keys -> "secret" (sb_secret_...) or legacy "service_role".
# It bypasses all access rules: keep it out of git, chat and logs.
SUPABASE_SERVICE_ROLE_KEY=
# A PRIVATE bucket (Storage -> New bucket, "Public bucket" off). Check with: npm run storage:check
SUPABASE_STORAGE_BUCKET=rpw-files

# Optional AI reading of invoices (docs/invoice-extraction.md). Leave the key empty to enter invoices by hand only.
ANTHROPIC_API_KEY=
INVOICE_AI_MODEL=claude-haiku-5-5
INVOICE_AI_HOURLY_LIMIT=30
