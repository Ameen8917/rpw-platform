# Copy to backend/.env and fill in. Never commit the real .env.

NODE_ENV=development
PORT=4000
# Browser origin allowed to call the API (the Vite dev server)
CORS_ORIGIN=http://localhost:5173

# Supabase → Connect (top bar) → Connection string → "Session pooler" (port 5432).
# Replace [YOUR-PASSWORD] with the database password.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Our tables live in this schema, not "public", so Supabase's Data API does not expose them
DATABASE_SCHEMA=rpw
# Supabase requires TLS; only set false for a local database without TLS
DATABASE_SSL=true
# Optional: path to Supabase's CA certificate (Database settings → SSL) to verify the server certificate.
# Without it the connection is still encrypted, but the certificate is not verified.
DATABASE_SSL_CA_PATH=

# Integration tests only: a SEPARATE Supabase project. Tests refuse to run if it equals DATABASE_URL.
TEST_DATABASE_URL=

# --- Later milestones (not read yet) ---
# M2 sign-in:        SESSION_SECRET=
# M4 file storage:   SUPABASE_URL=  SUPABASE_SERVICE_ROLE_KEY=  SUPABASE_STORAGE_BUCKET=
# M7 invoice AI:     ANTHROPIC_API_KEY=   (optional; manual entry works without it)
